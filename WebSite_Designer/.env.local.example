# Supabase – centralized selection persistence
# Copy this file to .env.local and fill in your project values.
# Both you and Tony must point to the same Supabase project.
#
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: set a base path when deploying to a sub-directory
# NEXT_PUBLIC_BASE_PATH=
OPENAI_API_KEY=your-openai-api-key
